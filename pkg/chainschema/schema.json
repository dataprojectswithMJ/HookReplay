{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hookreplay.dev/schemas/chain.schema.json",
  "title": "HookReplay Chain",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "steps"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64,
      "description": "Chain name; [a-z0-9-], <=64 chars."
    },
    "target": {
      "type": "string",
      "description": "Base target URL. Optional; --target flag wins; ${ENV} interpolated by CLI pre-run."
    },
    "environment": {
      "type": "string",
      "enum": ["local", "staging", "production"],
      "description": "Selects verified domain + env-scoped secrets."
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "Reserved for parallel groups; MVP executes sequentially."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique within the chain."
        },
        "webhook": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$",
          "description": "Provider/event template reference, e.g. stripe/checkout.session.completed."
        },
        "custom": { "$ref": "#/$defs/custom" },
        "api": { "$ref": "#/$defs/api" },
        "secret": {
          "type": "string",
          "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Secret reference; names only, never values."
        },
        "override": {
          "type": "object",
          "description": "Dotted-path patches applied to the rendered template payload."
        },
        "delay": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$",
          "description": "Delay before this step."
        },
        "deliver": { "$ref": "#/$defs/deliver" },
        "expect": { "$ref": "#/$defs/expect" },
        "when": {
          "type": "string",
          "description": "Conditional skip expression; references earlier steps only."
        }
      },
      "oneOf": [
        { "required": ["webhook"] },
        { "required": ["custom"] },
        { "required": ["api"] }
      ]
    },
    "custom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payload": { "type": ["string", "object"] },
        "headers": { "type": "object" },
        "sign": { "$ref": "#/$defs/sign" }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "url": { "type": "string" },
        "headers": { "type": "object" },
        "timeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" }
      }
    },
    "sign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "enum": ["hmac-sha1", "hmac-sha256", "hmac-sha512", "ed25519", "none"] },
        "secret": { "type": "string", "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$" },
        "header": { "type": "string" },
        "format": { "type": "string" },
        "encoding": { "type": "string", "enum": ["hex", "base64"] },
        "timestamp_header": { "type": "string" }
      }
    },
    "deliver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": { "type": "string", "enum": ["success", "fail"] },
        "reason": {
          "type": "string",
          "enum": [
            "invalid_signature",
            "missing_signature",
            "stale_signature",
            "malformed_payload",
            "connection_refused"
          ]
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": ["integer", "string"] },
        "latency_under": { "type": "string" },
        "retries": { "type": "integer" },
        "delays": { "type": "array", "items": { "type": "string" } },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "json_path": { "type": "string" },
            "equals": {},
            "contains": {},
            "exists": { "type": "boolean" }
          }
        }
      }
    }
  }
}
