# HookReplay — vertical slice environment (copy to .env and adjust)

# --- Server ---
HOOKREPLAY_HTTP_ADDR=:8080
HOOKREPLAY_DATABASE_URL=postgres://hookreplay:hookreplay@localhost:5432/hookreplay?sslmode=disable
# 32-byte master key for AES-256-GCM secret encryption (hex or base64).
# Generate one with: openssl rand -hex 32
HOOKREPLAY_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Dev API key used to bootstrap a local workspace (SHA-256 hashed at rest).
HOOKREPLAY_DEV_API_KEY=hrk_dev_local_dev_only_key
# Public base URL printed by the tunnel (used to build the tunnel URL).
HOOKREPLAY_PUBLIC_BASE_URL=http://localhost:8080
# Where the CLI's browser login redirects (the dashboard login page).
HOOKREPLAY_WEB_BASE_URL=http://localhost:3000
# GitHub OAuth (for "Continue with GitHub")
#   GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:          http://localhost:8080
#   Callback URL:          http://localhost:8080/v1/auth/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth (for "Continue with Google")
#   Google Cloud → APIs & Services → Credentials → OAuth client ID → Web application
#   Authorized JS origins:  http://localhost:3000
#   Authorized redirect URI: http://localhost:8080/v1/auth/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CLI ---
# HOOKREPLAY_API_KEY=hrk_dev_local_dev_only_key
# HOOKREPLAY_API_BASE=http://localhost:8080
